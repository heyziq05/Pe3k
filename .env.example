# Copy to .env and adjust. Every value is optional.

# --- Web server ---------------------------------------------------------
PE3K_HOST=127.0.0.1          # use 0.0.0.0 only if you also set PE3K_AUTH_PASSWORD
PE3K_PORT=5000
PE3K_DEBUG=false
PE3K_SECRET_KEY=change-me-to-a-long-random-string
# Optional HTTP Basic auth (recommended if PE3K_HOST is not 127.0.0.1)
PE3K_AUTH_USERNAME=admin
PE3K_AUTH_PASSWORD=

# --- Storage ------------------------------------------------------------
# PE3K_DATA_DIR=./data
# PE3K_DATABASE=./data/pe3k.sqlite3
# PE3K_LOG_DIR=./logs
PE3K_LOG_LEVEL=INFO
PE3K_MONITOR_RETENTION_DAYS=30
PE3K_BANDWIDTH_RETENTION_DAYS=90
PE3K_SCAN_LOG_RETENTION_DAYS=30

# --- Demo ---------------------------------------------------------------
# true = sample devices + simulated pings and a simulated "Demo" scanner
PE3K_DEMO_MODE=false

# --- Initial settings (only used for a brand-new database; change later in Settings)
PE3K_SETTINGS_MODE=simple            # simple (recommended presets, advanced fields locked) | pro
PE3K_DISCOVERY_ENGINE=manual         # nmap | scapy | manual
PE3K_AUTHORIZED_SUBNET=              # e.g. 192.168.1.0/24 — your own LAN only
PE3K_NMAP_PATH=                      # e.g. C:\Program Files (x86)\Nmap\nmap.exe (empty = use PATH)
PE3K_AUTO_SCAN=false
PE3K_STRICT_SCOPE=true
PE3K_SCAN_INTERVAL_SECONDS=300
PE3K_SCAN_TIMEOUT_SECONDS=60
PE3K_PING_INTERVAL_SECONDS=45
PE3K_PING_TIMEOUT_SECONDS=1.5
PE3K_PING_RETRIES=2
PE3K_FAILURE_THRESHOLD=3
PE3K_PING_METHOD=auto                # auto | ping3 | system
PE3K_BANDWIDTH_INTERFACE=all

# Bandwidth sampling
PE3K_BANDWIDTH_SAMPLE_SECONDS=5
PE3K_BANDWIDTH_PERSIST_SECONDS=60

# --- Phones & ARP cache (initial values; editable in Settings) -------------
PE3K_USE_ARP_CACHE=true              # merge `arp -a` into Nmap/Scapy scans
PE3K_PHONE_PING_TIMEOUT_SECONDS=3
PE3K_PHONE_PING_RETRIES=4
PE3K_PHONE_RETRY_DELAY_SECONDS=0.75
PE3K_PHONE_FAILURE_THRESHOLD=6
